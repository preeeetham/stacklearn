{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "bun install",
    "buildCommand": "cd apps/web && bun run build",
    "outputDirectory": "apps/web/dist",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "require-corp"
                }
            ]
        }
    ]
}
