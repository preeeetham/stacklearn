{
  "name": "stacklearn",
  "private": true,
  "workspaces": ["apps/server", "apps/web"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:server": "cd apps/server && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "bun run build:web && bun run build:server",
    "build:web": "cd apps/web && bun run build",
    "build:server": "cd apps/server && bun run build",
    "lint": "bun run lint:server && bun run lint:web",
    "lint:server": "cd apps/server && bunx tsc --noEmit",
    "lint:web": "cd apps/web && bunx tsc --noEmit"
  }
}
