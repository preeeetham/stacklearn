# Required — NVIDIA NIM (default provider). Get a key at https://build.nvidia.com
# Free tier: 40 requests/minute (the server retries 429s with backoff).
NVIDIA_API_KEY=nvapi-...

# Optional — Groq, enables the Groq models in the model picker
GROQ_API_KEY=gsk_...

# Optional — Firecrawl for higher quality doc scraping
FIRECRAWL_API_KEY=fc-...

# Optional — override default model
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Server port (default: 3001)
PORT=3001

# Frontend URL for CORS (default: http://localhost:5173)
CLIENT_URL=http://localhost:5173
